      "status": "amber",
      "kind": "launch checklist"
     }
    },
    {
     "id": "app-live-docs",
     "when": {
      "path": "docs/*.md"
     },
     "set": {
      "status": "amber",
      "kind": "plan"
     }
    }
   ],
   "mentions": [
    "contacts app",
    "the app\\b"
   ]
  },
  {
   "id": "supabase",
